<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="650.0" prefWidth="1100.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.Controller">

    <children>
        <Label text="Report grades" />
        <Label text="Select the course, Canvas assignment, and Ladok module for grade reporting" />

        <HBox prefHeight="100.0" prefWidth="200.0" spacing="20.0">
            <children>
                <VBox prefHeight="200.0" prefWidth="300.0">
                    <children>
                        <Label text="Course Code" />
                        <ComboBox fx:id="CourceCode" prefWidth="300.0" promptText="Select course" />
                        <VBox prefHeight="200.0" prefWidth="100.0" />
                    </children>
                </VBox>

                <VBox prefHeight="200.0" prefWidth="300.0">
                    <children>
                        <Label text="Canvas Assignment" />
                        <ComboBox fx:id="canvasAssignment" prefWidth="300.0" promptText="Select assignment" />
                    </children>
                </VBox>

                <VBox prefHeight="200.0" prefWidth="300.0">
                    <children>
                        <Label text="Ladok Module" />
                        <ComboBox fx:id="ladokModule" prefWidth="300.0" promptText="Select module" />
                    </children>
                </VBox>
            </children>
        </HBox>

        <HBox prefHeight="100.0" prefWidth="200.0" spacing="20.0">
            <children>
                <VBox prefHeight="200.0" prefWidth="300.0">
                    <children>
                        <Label text="Select" />
                        <HBox prefHeight="83.0" prefWidth="280.0" spacing="10.0">
                            <children>
                                <Button mnemonicParsing="false" prefWidth="75.0" text="All" onAction="#selectAll" />
                                <Button mnemonicParsing="false" prefWidth="75.0" text="Graded" />
                                <Button mnemonicParsing="false" prefWidth="75.0" text="None" onAction="#selectNone" />
                            </children>
                        </HBox>
                    </children>
                </VBox>

                <VBox prefHeight="200.0" prefWidth="300.0">
                    <children>
                        <Label text="Date for selected" />
                        <HBox prefHeight="100.0" prefWidth="200.0" spacing="10.0">
                            <children>
                                <DatePicker fx:id="examDatePicker" />
                                <Button mnemonicParsing="false" text="Set date" onAction="#setExamDate" />
                            </children>
                        </HBox>
                    </children>
                </VBox>

                <VBox prefHeight="200.0" prefWidth="300.0">
                    <children>
                        <HBox alignment="CENTER_RIGHT" prefHeight="10.0" prefWidth="300.0" spacing="91.0">
                            <children>
                                <Button mnemonicParsing="false" prefWidth="120.0" text="Transfer" />
                            </children>
                            <VBox.margin>
                                <Insets top="15.0" />
                            </VBox.margin>
                        </HBox>

                        <Label alignment="CENTER_RIGHT" prefHeight="0.0" prefWidth="300.0" text="Selected student: 0">
                            <padding>
                                <Insets top="10.0" />
                            </padding>
                        </Label>
                    </children>
                </VBox>
            </children>
        </HBox>

        <TableView fx:id="dispalyTable" prefHeight="350.0" prefWidth="200.0" VBox.vgrow="ALWAYS">
             <columns>
                <TableColumn fx:id="selectCol" maxWidth="45.0" minWidth="45.0" prefWidth="45.0" text="Select" />
                <TableColumn fx:id="nameCol" prefWidth="140.0" text="Name" />
                <TableColumn prefWidth="140.0" text="Canvas Grades" />
                <TableColumn fx:id="ladokGradeCol" prefWidth="140.0" text="Ladok Grade" />
                <TableColumn fx:id="examinationDateCol" prefWidth="140.0" text="Examination Date" />
                <TableColumn prefWidth="140.0" text="Status" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>
    </children>

    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
</VBox>
